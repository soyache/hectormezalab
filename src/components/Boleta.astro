---
const rows = [
  { name: 'Preaviso', value: '8,500.00' },
  { name: 'Cesantía', value: '34,000.00' },
  { name: 'Aguinaldo', value: '6,200.00' },
  { name: 'Décimo cuarto', value: '5,400.00' },
  { name: 'Vacaciones', value: '4,100.00' },
];
---

<aside class="boleta" aria-label="Boleta de ejemplo. Las cifras no son un cálculo real.">
  <div class="perforation" aria-hidden="true"></div>
  <div class="px-5 pb-6 pt-4">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-muted">
          Prestaciones Laboral Honduras
        </p>
        <p class="mt-2 font-display text-[1.7rem] leading-none tracking-tight">Boleta de ejemplo</p>
      </div>
      <p class="stamp">Ejemplo</p>
    </div>
    <p class="mt-4 font-mono text-xs text-muted">01/03/2024 — 28/02/2026 · muestra</p>
    <table class="mt-4 w-full border-collapse text-left">
      <caption class="sr-only">
        Cinco rubros con cifras inventadas para enseñar el formato. No uses estos montos como liquidación.
      </caption>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-line">
              <th scope="row" class="py-3 pr-3 text-base font-normal">
                {row.name}
              </th>
              <td class="whitespace-nowrap py-3 text-right font-mono text-sm tabular-nums text-paper">
                L {row.value}
              </td>
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" class="pt-4 text-left font-display text-lg font-semibold">
            Total de muestra
          </th>
          <td class="pt-4 text-right font-mono text-lg font-medium tabular-nums text-amber">
            L 58,200.00
          </td>
        </tr>
      </tfoot>
    </table>
    <p class="mt-5 text-sm leading-relaxed text-muted">
      Cifras inventadas para mostrar el formato. Tu resultado sale del salario, las fechas y los rubros que actives.
    </p>
  </div>
</aside>
