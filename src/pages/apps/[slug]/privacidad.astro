---
import { apps, type AppRecord } from '../../../data/apps';
import Base from '../../../layouts/Base.astro';

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppRecord;
}

const { app } = Astro.props;
---

<Base
  title={`Privacidad de ${app.name} — HectorMezaLab`}
  description={`Privacidad de ${app.name}, app de HectorMezaLab. Contacto: hectormezalab@gmail.com.`}
>
  <article class="mx-auto max-w-3xl px-5 py-14 md:py-20">
    <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">
      <a class="hover:text-paper" href={`/apps/${app.slug}`}>{app.name}</a>
    </p>
    <h1 class="mt-3 font-display text-5xl tracking-tight">Privacidad</h1>
    <p class="mt-4 text-muted">Actualizada el 5 de octubre de 2026. Sirve como URL de política de privacidad de esta app en Google Play.</p>

    <div class="mt-10 grid gap-10 text-lg leading-relaxed">
      <section>
        <h2 class="font-display text-3xl tracking-tight">Responsable</h2>
        <p class="mt-3 text-muted">
          Héctor Meza, HectorMezaLab, Honduras.
          <a class="text-paper underline decoration-amber underline-offset-4" href="mailto:hectormezalab@gmail.com">hectormezalab@gmail.com</a>
        </p>
      </section>
      <section>
        <h2 class="font-display text-3xl tracking-tight">{app.name}</h2>
        <p class="mt-3 text-muted">{app.privacy.intro}</p>
        <p class="mt-3 font-mono text-sm text-paper">{app.packageId}</p>
        <ul class="mt-4 grid list-disc gap-3 pl-5 text-muted">
          {app.privacy.points.map((point) => <li>{point}</li>)}
        </ul>
        {
          app.playUrl && (
            <p class="mt-4">
              <a class="underline decoration-amber underline-offset-4" href={app.playUrl} target="_blank" rel="noopener noreferrer">
                Ficha en Google Play
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            </p>
          )
        }
      </section>
      {
        app.disclaimer && (
          <section class="aviso px-6 py-6">
            <h2 class="font-display text-3xl tracking-tight">Aviso</h2>
            <p class="mt-3">{app.disclaimer.text}</p>
          </section>
        )
      }
      <p class="text-base text-muted">
        La privacidad del sitio (no de una app concreta) está en <a class="text-paper underline decoration-amber underline-offset-4" href="/privacidad">/privacidad</a>.
      </p>
    </div>
  </article>
</Base>
