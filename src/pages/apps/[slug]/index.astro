---
import { apps, catalogAnchor, hasDetailPage, statusLabel, type AppRecord } from '../../../data/apps';
import Base from '../../../layouts/Base.astro';
import Boleta from '../../../components/Boleta.astro';

export function getStaticPaths() {
  return apps
    .filter((app) => hasDetailPage(app.status))
    .map((app) => ({
      params: { slug: app.slug },
      props: { app },
    }));
}

interface Props {
  app: AppRecord;
}

const { app } = Astro.props;
---

<Base title={`${app.name} — HectorMezaLab`} description={app.summary}>
  <article class="mx-auto max-w-5xl px-5 py-12 md:py-16">
    <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">
      <a class="hover:text-paper" href={catalogAnchor(app.status)}>{statusLabel(app.status)}</a>
      <span aria-hidden="true"> / </span>
      {app.platform}
    </p>
    <div class="mt-6 grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(280px,380px)] lg:gap-14">
      <div>
        <h1 class="font-display text-4xl leading-[1.02] tracking-tight sm:text-5xl">{app.name}</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{app.summary}</p>
        {app.packageId && <p class="mt-4 font-mono text-xs text-paper">{app.packageId}</p>}
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          {
            app.playUrl && (
              <a
                href={app.playUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center justify-center rounded-full bg-amber px-5 font-bold text-amber-ink hover:bg-amber-hot"
              >
                Ver en Google Play
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            )
          }
          {
            app.downloadUrl && (
              <a
                href={app.downloadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center justify-center rounded-full bg-amber px-5 font-bold text-amber-ink hover:bg-amber-hot"
              >
                {app.downloadLabel ?? 'Descargar'}
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            )
          }
          {
            app.contact && (
              <a
                href={app.contact.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center justify-center text-paper underline decoration-amber decoration-2 underline-offset-4"
              >
                {app.contact.label}
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            )
          }
          {
            app.privacy && (
              <a
                href={`/apps/${app.slug}/privacidad`}
                class="inline-flex min-h-12 items-center justify-center text-paper underline decoration-amber decoration-2 underline-offset-4"
              >
                Privacidad de la app
              </a>
            )
          }
        </div>
        {
          app.steps && app.steps.length > 0 && (
            <ol class="mt-10 border-l border-line">
              {app.steps.map((step, index) => (
                <li class="relative pb-7 pl-7 last:pb-0">
                  <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-amber" aria-hidden="true" />
                  <p class="font-mono text-xs uppercase tracking-[0.16em] text-amber">{index + 1}</p>
                  <p class="mt-2 max-w-md text-lg leading-relaxed">{step}</p>
                </li>
              ))}
            </ol>
          )
        }
      </div>
      {app.sample === 'boleta' && <Boleta />}
    </div>

    {
      app.disclaimer && (
        <div class="aviso mt-14 px-6 py-7 md:px-8">
          <h2 class="font-display text-2xl tracking-tight">Aviso</h2>
          <p class="mt-3 max-w-3xl text-lg leading-relaxed">{app.disclaimer.text}</p>
          <ul class="mt-5 grid gap-3">
            {app.disclaimer.links.map((link) => (
              <li>
                <a
                  class="underline decoration-amber/80 underline-offset-4 hover:decoration-amber"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label}
                  <span class="sr-only"> (se abre en una pestaña nueva)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </article>
</Base>
