---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import { catalogSections } from '../data/apps';

const sections = catalogSections();
---

<Base
  title="HectorMezaLab — apps y software"
  description="HectorMezaLab es el taller de Héctor Meza en Honduras. Apps en Google Play, software para negocios y descargas directas."
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-14 md:pb-14 md:pt-20">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber">Héctor Meza · Honduras</p>
    <h1 class="mt-4 max-w-[16ch] font-display text-[2.7rem] leading-[0.95] tracking-tight text-paper sm:text-6xl">
      Apps y software desde Honduras.
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
      HectorMezaLab es el sitio de Héctor Meza. Aquí están las apps que publica en Google Play, el software para negocios y las descargas directas.
    </p>
  </section>

  {
    sections.map((section, index) => (
      <section
        id={section.id}
        class:list={['mx-auto max-w-5xl px-5', index === sections.length - 1 ? 'pb-16 md:pb-24' : 'pb-12 md:pb-16']}
        aria-labelledby={`${section.id}-titulo`}
      >
        <div class="mb-5 flex items-baseline justify-between gap-4 border-b border-line pb-3">
          <h2 id={`${section.id}-titulo`} class="font-display text-3xl tracking-tight">
            {section.title}
          </h2>
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">{section.countLabel}</p>
        </div>
        <div class="catalog">
          {section.apps.map((app) => (
            <AppCard app={app} />
          ))}
        </div>
      </section>
    ))
  }

  <section class="border-t border-line" aria-labelledby="taller-titulo">
    <div class="mx-auto max-w-5xl px-5 py-14 md:py-16">
      <h2 id="taller-titulo" class="font-display text-3xl tracking-tight">El taller</h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Soy Héctor Meza. Escribo estas apps y estos programas en Honduras y los firmo como HectorMezaLab.
      </p>
      <p class="mt-5 text-lg">
        <a class="underline decoration-amber decoration-2 underline-offset-4" href="mailto:hectormezalab@gmail.com">
          hectormezalab@gmail.com
        </a>
      </p>
    </div>
  </section>
</Base>
