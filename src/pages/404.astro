---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada — HectorMezaLab" description="Esa ruta no existe en el sitio de HectorMezaLab.">
  <section class="mx-auto max-w-3xl px-5 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber">404</p>
    <h1 class="mt-3 font-display text-5xl tracking-tight">Esa hoja no está en el taller.</h1>
    <p class="mt-4 text-lg text-muted">La dirección no corresponde a ninguna página de HectorMezaLab.</p>
    <a class="mt-8 inline-flex min-h-12 items-center text-paper underline decoration-amber decoration-2 underline-offset-4" href="/">
      Volver al inicio
    </a>
  </section>
</Base>
